# DailyQuoteBlaster environment variables
# Copy to .env for local development. In production these live as:
#   - Netlify site environment variables (for the functions: DATABASE_URL)
#   - GitHub Actions secrets (for the daily send: DATABASE_URL, RESEND_API_KEY, SENDER_EMAIL)
# Never commit a real .env. Never put these in client-side code.

# --- Database (Neon serverless Postgres) ---
# Neon connection string. Used by the Netlify functions and the send job.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# --- Email (Resend, free tier) ---
RESEND_API_KEY=your_resend_api_key_here
# Sender address. Must be a verified Resend domain, or use onboarding@resend.dev for testing.
SENDER_EMAIL=daily-quotes@resend.dev

# --- SMS (Twilio, optional) ---
# Leave these unset for email-only (no Twilio cost). Set all three to enable SMS.
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# --- Testing (optional) ---
# RUN_IMMEDIATELY=true
# TEST_TIME_OF_DAY=morning
